# All optional.

# Public address of the site, used in canonical links, the sitemap, structured data and social cards.
# Change this when the custom domain (shehryar-tariq.dev) is back.
SITE_URL=https://shehryartariq.vercel.app

# Google Search Console HTML-tag verification token (the content="..." value only).
GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools verification token (msvalidate.01).
BING_SITE_VERIFICATION=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Leave empty to load no analytics.
GA_MEASUREMENT_ID=

# 1 = use sample status data instead of checking the live projects (tests, offline builds).
STATUS_SAMPLE_DATA=
